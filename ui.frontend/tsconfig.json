{
    "compilerOptions": {
        "target": "es5",
        "module": "es6",
        "moduleResolution": "node", // Resolves modules in `node_modules`
        "baseUrl": "../ui.frontend",
        "removeComments": true,
        "allowJs": true,
        "preserveConstEnums": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true, // Allows default imports from CommonJS modules
        "sourceMap": true
    },
    "include": [
        "./src/**/*.ts"
    ]
}
