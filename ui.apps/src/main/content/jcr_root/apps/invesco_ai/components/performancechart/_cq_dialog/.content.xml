<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Performance Chart"
          sling:resourceType="cq/gui/components/authoring/dialog"
          componentId="performance-chart">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        granite:class="performance-chart-container">
        <items jcr:primaryType="nt:unstructured">
            <chartTitle
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Chart Title"
                name="./chartTitle"
                required="{Boolean}true"
                granite:class="performance-chart-title"/>
            <chartType
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                fieldLabel="Chart Type"
                name="./chartType"
                required="{Boolean}true"
                granite:class="performance-chart-type">
                <items jcr:primaryType="nt:unstructured">
                    <barchart jcr:primaryType="nt:unstructured" text="Bar Chart" value="barchart"/>
                    <linechart jcr:primaryType="nt:unstructured" text="Line Chart" value="linechart"/>
                    <piechart jcr:primaryType="nt:unstructured" text="Pie Chart" value="piechart"/>
                </items>
            </chartType>
            <theme
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                fieldLabel="Theme"
                name="./theme"
                granite:class="performance-chart-theme">
                <items jcr:primaryType="nt:unstructured">
                    <etf jcr:primaryType="nt:unstructured" text="ETF" value="ETF"/>
                    <mutualFund jcr:primaryType="nt:unstructured" text="Mutual Fund" value="MUTUAL_FUND"/>
                    <!-- Add additional themes as needed -->
                </items>
            </theme>
            <dataSourceUrl
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Data Source URL"
                name="./dataSourceUrl"
                granite:class="performance-chart-datasource"/>
            <generateButton
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/button"
                text="Generate Chart"
                variant="primary"
                granite:class="performance-chart-generate-button"/>
        </items>
    </content>
</jcr:root>
