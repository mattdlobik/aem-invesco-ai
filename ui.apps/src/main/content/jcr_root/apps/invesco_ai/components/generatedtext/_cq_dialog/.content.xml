<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Generate Text"
          sling:resourceType="cq/gui/components/authoring/dialog"
          componentId="text-generator">
    <content
        granite:class="text-generator-container"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <promptTemplate
                granite:class="text-generator-prompt"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                fieldLabel="Prompt Template"
                name="./promptTemplate"
                required="{Boolean}true"/>
            <fundTicker
                granite:class="text-generator-ticker"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Fund Ticker"
                name="./fundTicker"
                required="{Boolean}true"/>
            <generateButton
                granite:class="text-generator-button"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/button"
                text="Generate Text"
                variant="primary"/>
        </items>
    </content>
</jcr:root>
